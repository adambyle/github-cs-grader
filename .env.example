# Copy to .env and fill in (README.md, "Configure .env"). .env is gitignored;
# never commit it.

# From the GitHub App's settings page
GITHUB_APP_ID=
# The App's URL name: the <slug> in github.com/apps/<slug>
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
# Path ON YOUR MACHINE to the App's downloaded private key, outside this
# repository. Forward slashes work on Windows, e.g. C:/Users/you/.secrets/coursekit-dev.pem
# Compose mounts it into the containers at /run/secrets/github-app.pem.
GITHUB_APP_PRIVATE_KEY_FILE=

# Your smee.io channel; forwards GitHub webhooks to the web container
SMEE_URL=

BASE_URL=http://localhost:5000
# Two random secrets. Generate each with:
#   docker run --rm python:3.14-slim python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
# Encrypts stored GitHub sign-in tokens. Must be this format:
#   docker run --rm python:3.14-slim python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
TOKEN_ENCRYPTION_KEY=
DATABASE_URL=sqlite:////data/coursekit.db
HUEY_DB=/data/huey.db
